{
  "name": "lifeos",
  "private": true,
  "version": "0.1.0",
  "description": "LifeOS — independent personal & professional management platform",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @lifeos/api run dev",
    "dev:web": "pnpm --filter @lifeos/web run dev",
    "dev:worker": "pnpm --filter @lifeos/worker run dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:migrate": "npx supabase migration up",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
