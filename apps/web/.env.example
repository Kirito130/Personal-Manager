# Copy to .env.local. Prefer cloud values from the repo-root .env (see docs/runbooks/supabase-cloud.md).
# Do not leave this pointing at 127.0.0.1 unless `npx supabase start` is running.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
